```gitignore
# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# IDE settings
.vscode/
.idea/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Build and distribution
build/
dist/
*.egg-info/

# Logs
*.log

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Jupyter Notebook
.ipynb_checkpoints/

# Temporary files
*.tmp
*.bak
*.swp

# Local database files
*.sqlite3
*.db
```
